&lt;/span>&lt;/code>&lt;/pre>&lt;/td>
&lt;td style="vertical-align:top;padding:0;margin:0;border:0;;width:100%">
&lt;pre tabindex="0" style="color:#f8f8f2;background-color:#272822;-moz-tab-size:4;-o-tab-size:4;tab-size:4;">&lt;code class="language-fallback" data-lang="fallback">&lt;span style="display:flex;">&lt;span>$ cd ~/.tmp/agent-blog-cache/opentitan
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>$ du -sh hw sw util doc
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>207M hw
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> 39M sw
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>4.9M util
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span> 11M doc
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>$ ls -la | head -20
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>total 5936
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>-rw-r--r-- .bazelrc 6.4K
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>-rw-r--r-- .svlint.toml 1.4K
&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>-rw-r--r-- BLOCKFILE 4.4K
