&lt;/span>&lt;/span>&lt;span style="display:flex;">&lt;span>980884f draft: FlexNOC NIU &lt;span style="color:#ae81ff">11&lt;/span> - 协议专篇 AXI-Lite NIU &lt;span style="color:#f92672">[&lt;/span>中英对照&lt;span style="color:#f92672">]&lt;/span>
&lt;/span>&lt;/span>&lt;/code>&lt;/pre>&lt;/td>&lt;/tr>&lt;/table>
